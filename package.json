{
  "name": "dsh-why-reject-me",
  "version": "0.3.3",
  "description": "Adds an optional rejection reason to DSH permission approval prompts and delivers it with the rejected tool result.",
  "license": "MIT",
  "author": "Jorgen233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jorgen233/dsh-why-reject-me.git"
  },
  "homepage": "https://github.com/Jorgen233/dsh-why-reject-me#readme",
  "bugs": {
    "url": "https://github.com/Jorgen233/dsh-why-reject-me/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "approval",
    "permission",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "node test/smoke-client.mjs && node test/smoke-panel.mjs && node test/smoke-host.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
